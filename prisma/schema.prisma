// Prisma schema — auth (Auth.js) + order & pembayaran
// Postgres (lihat docs/SCALING.md). Dev: Postgres lokal via Docker (port 5433).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth.js ─────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null untuk akun OAuth-only
  role          String    @default("customer") // customer | admin
  suspended     Boolean   @default(false) // akun dibekukan (tidak bisa login)
  notes         String? // catatan admin
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  emailTokens   EmailToken[]

  createdAt     DateTime  @default(now())
}

// Catatan aktivitas admin (freeze, reset password, edit notes, dsb.)
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorId     String
  actorEmail  String
  targetId    String?
  targetEmail String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

// Token untuk verifikasi email & reset password (type: verify | reset)
model EmailToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Order & Payment ─────────────────────────

model Order {
  id           String   @id @default(cuid())
  orderNumber  Int?     @unique // nomor urut rapi untuk ditampilkan (#0001)
  // Restrict eksplisit: user berorder tak bisa dihapus (kebijakan "bekukan,
  // jangan hapus"). Ini juga default Prisma untuk relasi wajib — dibuat jelas.
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId       String

  serviceId    String
  serviceTitle String
  brief        String
  phone        String?

  // requested | quoted | dp_paid | in_progress | awaiting_settlement | completed | cancelled
  status       String   @default("requested")

  agreedTotal  Int? // diisi admin saat quote
  dpAmount     Int? // diisi admin saat quote
  progressPct  Int      @default(0)
  progressNote String?

  payments     Payment[]
  tickets      Ticket[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Komplain / permintaan revisi / permintaan refund per order.
model Ticket {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String

  type      String // revision | complaint | refund
  message   String
  status    String   @default("open") // open | in_review | resolved | rejected
  response  String? // balasan admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model Payment {
  id                String    @id @default(cuid())
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String

  type              String // dp | settlement
  grossAmount       Int
  midtransOrderId   String    @unique // order_id ke Midtrans, mis. <orderId>-DP
  transactionId     String?   @unique // transaction_id Midtrans (idempotency)
  transactionStatus String    @default("pending")
  paymentType       String?
  snapToken         String?
  paidAt            DateTime?

  createdAt         DateTime  @default(now())

  @@index([orderId])
}
