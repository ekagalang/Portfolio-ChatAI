# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GitHub username kamu
GITHUB_USERNAME=

# Optional: https://github.com/settings/tokens
GITHUB_TOKEN=

# Resend API key - https://resend.com/api-keys
RESEND_API_KEY=

# Email tujuan notifikasi (inbox kamu)
CONTACT_EMAIL=

# Email pengirim - pakai domain Resend gratis: onboarding@resend.dev
# Kalau sudah punya domain sendiri, ganti dengan: noreply@yourdomain.com
FROM_EMAIL=

# Optional: Umami analytics
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_URL=

# Midtrans Payment Gateway - https://dashboard.sandbox.midtrans.com (Settings → Access Keys)
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
# URL publik app kamu (untuk callbacks.finish ke Midtrans)
# Development: pakai ngrok / expose tool. Production: domain asli.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Database (Prisma). Dev: SQLite. Postgres: lihat docs/SCALING.md
# DATABASE_URL="postgresql://user:pass@host:5432/portfolio?schema=public"
DATABASE_URL="file:./dev.db"

# Redis (opsional) — rate limiter multi-instance. Kosong = in-memory.
# Lihat docs/SCALING.md. Contoh VPS: redis://redis_cache:6379
REDIS_URL=

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=
# URL kanonik publik — WAJIB di produksi di belakang reverse proxy, kalau tidak
# Auth.js salah menebak host (mis. 0.0.0.0:3000) → callback OAuth invalid.
AUTH_URL=https://yourdomain.com
# Email yang otomatis jadi admin (pisahkan koma untuk banyak)
ADMIN_EMAILS=
# Google OAuth (opsional; email/password tetap jalan tanpa ini)
# WAJIB daftarkan redirect URI di Google Console:
#   https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
